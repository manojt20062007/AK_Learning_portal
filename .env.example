
# ============================================================
# AK Learning Platform - Environment Variables Template
# Copy this file to .env in apps/backend and apps/frontend
# ============================================================

# ---- BACKEND (apps/backend/.env) ----

# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/ak_learning_platform"

# Server
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Session & Security
SESSION_SECRET="change-this-to-a-long-random-string-at-least-64-chars"
CSRF_SECRET="another-long-random-string-for-csrf-protection"
COOKIE_DOMAIN="localhost"

# Initial Admin Account (used only during first-time seed)
ADMIN_EMAIL="admin@aklms.com"
ADMIN_PASSWORD="ChangeMe@123!"
ADMIN_NAME="Platform Admin"

# Cloudflare R2 (Phase 4 - Video Infrastructure)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""

# Email (Phase 3 - Brevo SMTP for Student Invitations)
# In Brevo: SMTP & API -> SMTP -> use smtp-relay.brevo.com, port 587
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-brevo-smtp-login"
SMTP_PASS="your-brevo-smtp-key"
EMAIL_FROM="AK Learning <noreply@aklms.com>"

# WhatsApp (Phase 3 - via Twilio or similar)
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""
WHATSAPP_FROM_NUMBER=""

# ---- FRONTEND (apps/frontend/.env.local) ----

NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="AK Learning"
NEXT_PUBLIC_APP_TAGLINE="Master Your Skills, Transform Your Future"
